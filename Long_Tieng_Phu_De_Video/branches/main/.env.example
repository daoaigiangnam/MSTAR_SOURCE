# ============================================================
# VideoDubing API
# ============================================================
VIDEODUBING_API_URL=http://127.0.0.1:3000/api/v1
VIDEODUBING_API_TIMEOUT=60
VIDEODUBING_WEB_URL=https://videotool.review360.id.vn
APP_NAME=VideoDubing AI

# ============================================================
# FrontEnd MySQL
# ============================================================
# Keep these values OUT of Git. Configure them in PHP-FPM/systemd.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=videodubing
DB_USER=videodubing
DB_PASSWORD=change-me

# ============================================================
# Account policy
# ============================================================
TRIAL_DAYS=30
ACTIVATION_TOKEN_MINUTES=1440
PASSWORD_RESET_TOKEN_MINUTES=60
SESSION_NAME=videodubing_session

# ============================================================
# SMTP
# ============================================================
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=no-reply@review360.id.vn
MAIL_PASSWORD=change-me
MAIL_ENCRYPTION=tls
MAIL_FROM=no-reply@review360.id.vn
MAIL_FROM_NAME=VideoDubing AI

# ============================================================
# SePay payment webhook
# ============================================================
# NEVER commit the real secret to GitHub.
SEPAY_WEBHOOK_SECRET=replace-with-sepay-hmac-secret
SEPAY_BANK_GATEWAY=BIDV
SEPAY_BANK_ACCOUNT=replace-with-your-bidv-account
PAYMENT_ORDER_PREFIX=DH
PAYMENT_ORDER_DIGITS=10

# ============================================================
# Shared secret for API <-> Worker internal callbacks.
# ============================================================
INTERNAL_TOKEN=replace-with-a-long-random-secret

# ============================================================
# Cleanup policy
# ============================================================
CLEANUP_ENABLED=false
CLEANUP_TTL_HOURS=2
CLEANUP_INTERVAL_MINUTES=5
