# Shared secret for API <-> Worker internal callbacks.
# Generate a long random value for production.
INTERNAL_TOKEN=replace-with-a-long-random-secret

# ============================================================
# Cleanup policy
# ============================================================
# Keep false during development/testing so no job data is deleted.
CLEANUP_ENABLED=false

# Terminal jobs (completed/failed/cancelled) are removed after this many hours.
# TTL is calculated from jobs.finished_at, not created_at or folder mtime.
CLEANUP_TTL_HOURS=2

# How often the cleanup service scans for expired terminal jobs.
CLEANUP_INTERVAL_MINUTES=5
